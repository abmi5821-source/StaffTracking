<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>متابعة موظفي الفروع</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">منصة متابعة موظفي الفروع</a>
      @if (User.Identity.IsAuthenticated)
      {
        <form method="post" asp-controller="Account" asp-action="Logout" class="d-flex align-items-center gap-3">
          <span class="text-white">@User.Identity.Name</span>
          <button class="btn btn-outline-light btn-sm">تسجيل الخروج</button>
        </form>
      }
    </div>
  </nav>
  <div class="container">@RenderBody()</div>
</body>
</html>
