@model List<AppUser>
@{ var regions = (Dictionary<int, string>)ViewBag.Regions; }
<div class="d-flex justify-content-between mb-3"><h4>المستخدمون</h4><a class="btn btn-primary" asp-action="Create">+ مستخدم جديد</a></div>
<table class="table table-bordered bg-white">
  <thead class="table-dark"><tr><th>اسم المستخدم</th><th>الاسم</th><th>الصلاحية</th><th>المندوبية</th><th>الحالة</th><th></th></tr></thead>
  <tbody>
  @foreach (var u in Model)
  {
    <tr>
      <td>@u.UserName</td><td>@u.FullName</td>
      <td>@(u.Role == "DeptManager" ? "مدير القسم" : "مدير مندوبية")</td>
      <td>@(u.RegionId != null && regions.ContainsKey(u.RegionId.Value) ? regions[u.RegionId.Value] : "-")</td>
      <td>@(u.IsActive ? "فعّال" : "موقوف")</td>
      <td><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@u.UserId">تعديل / كلمة سر</a></td>
    </tr>
  }
  </tbody>
</table>
