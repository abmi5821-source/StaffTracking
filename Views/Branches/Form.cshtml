@model Branch
@{ var regions = (List<Region>)ViewBag.Regions; bool isNew = Model.BranchId == 0; }
<h4 class="mb-3">@(isNew ? "فرع جديد" : "تعديل فرع")</h4>
<div class="card" style="max-width:520px"><div class="card-body">
<form method="post">
  <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
  <div class="mb-3"><label class="form-label">اسم الفرع</label><input asp-for="Name" class="form-control" /></div>
  <div class="mb-3"><label class="form-label">الرمز (اختياري)</label><input asp-for="Code" class="form-control" /></div>
  <div class="mb-3"><label class="form-label">المندوبية</label>
    <select asp-for="RegionId" asp-items="@(new SelectList(regions, "RegionId", "Name"))" class="form-select"></select></div>
  <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label class="form-check-label">الفرع فعّال</label></div>
  <button class="btn btn-primary">حفظ</button> <a class="btn btn-link" asp-action="Index">رجوع</a>
</form></div></div>
